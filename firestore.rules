rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isAuthed() && request.auth.token.role == 'super_admin';
    }
    function belongsToTenant(tenantId) {
      return isAuthed() && request.auth.token.tenantId == tenantId;
    }
    function isClientRole() {
      return isAuthed() && request.auth.token.role == 'client';
    }

    // Tenant document: members and Super Admin may read. Writes remain server-only.
    match /tenants/{tenantId} {
      allow read: if isSuperAdmin() || belongsToTenant(tenantId);
      allow write: if false;
    }

    // Tenant activity feed: the ONLY tenant subcollection read directly from the
    // browser (app/activity, components/activity/ActivityFeed via onSnapshot).
    // Internal staff only; client role excluded. Writes go through the Admin SDK.
    //
    // NOTE: this deliberately replaces the previous blanket
    // `/tenants/{tenantId}/{subcollection=**}` read rule. That wildcard exposed
    // EVERY tenant subcollection to the client SDK — including
    // support_tickets/** (internal notes flagged isInternal, reporter emails,
    // and base64 screenshots). Support tickets are served exclusively through
    // Admin SDK API routes, so no legitimate browser reader is lost by denying
    // client-SDK access here. Any future subcollection that genuinely needs
    // browser reads must be given its own explicit match block below.
    match /tenants/{tenantId}/activity_feed/{docId} {
      allow read: if isSuperAdmin() || (belongsToTenant(tenantId) && !isClientRole());
      allow write: if false;
    }

    // All other tenant subcollections (support_tickets, support_meta, and every
    // future subcollection): server SDK only for every role.
    match /tenants/{tenantId}/{subcollection}/{docId=**} {
      allow read, write: if false;
    }

    // users: a user may read only their own document; Super Admin may read for governance.
    // Writes are server-only for every role.
    match /users/{docId} {
      allow read: if isSuperAdmin() || (isAuthed() && request.auth.uid == docId);
      allow write: if false;
    }

    // clients: server SDK only (no client-SDK reader exists).
    match /clients/{docId} {
      allow read, write: if false;
    }

    // projects: server SDK only.
    match /projects/{docId} {
      allow read, write: if false;
    }

    // invoices: server SDK only.
    match /invoices/{docId} {
      allow read, write: if false;
    }

    // notifications: a user may read ONLY their own notifications. Writes server-only.
    match /notifications/{docId} {
      allow read: if isSuperAdmin()
                  || (isAuthed()
                      && request.auth.uid == resource.data.userId
                      && belongsToTenant(resource.data.tenantId));
      allow write: if false;
    }

    // Platform and tenant settings are API-only. In particular, launchChecklist controls
    // public signup and must never be read or changed with a browser Firebase credential,
    // including a Super Admin credential. The guarded API uses the Admin SDK.
    match /settings/{docId} {
      allow read, write: if false;
    }

    // Cron orchestration state and leases are server-only operational controls.
    match /cron_orchestration_runs/{docId} {
      allow read, write: if false;
    }
    match /cron_job_leases/{docId} {
      allow read, write: if false;
    }
    match /cron_job_executions/{docId} {
      allow write: if false;
      allow read: if false;
    }

    // Everything else: server SDK only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
