# Bizosto ERP — environment variable reference (.env.example)
#
# Copy to .env.local for local work. NEVER commit real secrets.
# The BOOT-CRITICAL block below is validated at server startup by lib/env.ts
# (assertServerEnv, called from instrumentation.ts). Missing/invalid values there
# fail fast with a clear message instead of a confusing runtime 500.
#
# Everything under OPTIONAL / DEFERRED is intentionally NOT required — those
# integrations are empty pre-launch and must not block boot.

# ─────────────────────────────────────────────────────────────
# BOOT-CRITICAL (validated by lib/env.ts — server MUST have these at runtime)
# ─────────────────────────────────────────────────────────────
# Explicit Bizosto deployment mode; never infer production safety from NODE_ENV alone.
BIZOSTO_ENVIRONMENT=development
# Firebase Admin service-account JSON (single line). Its project_id must equal
# FIREBASE_EXPECTED_PROJECT_ID for this deployment. Local emulator use leaves it empty.
FIREBASE_ADMIN_KEY=
# Project assigned to THIS deployment target. Preview must use a staging project;
# local emulator work must use a disposable demo-* project ID.
FIREBASE_EXPECTED_PROJECT_ID=demo-bizosto-local
# Production boundary used to prove preview is isolated. Set this in every target.
FIREBASE_PRODUCTION_PROJECT_ID=your-production-project-id
# Optional while Storage is disabled. Once any bucket is configured, all three names
# must be set; preview's expected/public bucket must differ from production's bucket.
FIREBASE_EXPECTED_STORAGE_BUCKET=
FIREBASE_PRODUCTION_STORAGE_BUCKET=
# Resend transactional email API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Shared secret authenticating cron routes (Bearer). Use at least 32 random characters;
# it must not contain whitespace or use the placeholder "change-me-in-production".
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# CLIENT (NEXT_PUBLIC_*) — inlined at build time, checked by the build, not lib/env.ts
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-bizosto-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_DEFAULT_TENANT_ID=bizosto
# Canonical app origin. Still to be set in Vercel; several links/redirects fall
# back to https://app.bizosto.com when absent.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only compatibility origin used by a few provider callbacks. Keep aligned with
# NEXT_PUBLIC_APP_URL; new code should prefer the canonical public variable above.
APP_URL=
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─────────────────────────────────────────────────────────────
# PLATFORM / INFRA (set in production; not boot-gated by lib/env.ts)
# ─────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
INTERNAL_REQUEST_SIGNING_SECRET=
INTERNAL_USAGE_LOG_KEY=
INTERNAL_API_KEY_CURRENT=
INTERNAL_API_KEY_PREVIOUS=
AI_TOOL_BUS_SECRET=
AI_BYOK_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
ERP_INGEST_KEY=
ERP_ORDER_PREFIX=
DEFAULT_TENANT_ID=
FIREBASE_STORAGE_BUCKET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
API_DEPRECATION_NOTIFY_EMAILS=
# One Vercel cron owns a bounded daily runtime budget. Keep below the function limit.
DAILY_CRON_RUNTIME_BUDGET_MS=270000
# Retention work is deliberately small because one policy can scan/write hundreds of records.
DAILY_RETENTION_TENANT_BATCH_SIZE=1
# Invoice reminders enqueue at most this many candidates; capacity overflow is owner-blocked.
DAILY_INVOICE_REMINDER_LIMIT=100
# Destructive abandoned-signup review rotates through a small auditable tenant page.
DAILY_ABANDONED_SIGNUP_TENANT_BATCH_SIZE=5
# Trial reminders scan every beta tenant in one run; higher scale is surfaced as a blocker.
DAILY_TRIAL_TENANT_BATCH_SIZE=25
# Billing reconciliation rotates through the controlled-beta tenant set in one page.
DAILY_BILLING_TENANT_BATCH_SIZE=25
# Financial mutations remain disabled until their isolated sandbox gates pass.
ERP_ENABLE_RECURRING_INVOICES=false
ERP_ENABLE_INVOICE_LATE_FEES=false
# Backup export remains an owner-blocked manual operation on Hobby; these tune retention.
BACKUP_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────
# ISOLATED DEMO / EMULATOR SAFETY (server-only; disabled by default)
# ─────────────────────────────────────────────────────────────
DEMO_DATA_MUTATIONS_ENABLED=false
DEMO_FIREBASE_PROJECT_ID=
# Secret JSON maps. Configure only in the relevant server/CI secret store.
DEMO_USER_PASSWORDS_JSON=
E2E_DEMO_PASSWORDS_JSON=
E2E_EXPECTED_FIREBASE_PROJECT_ID=
E2E_ISOLATED_ENVIRONMENT=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Onboarding "from" address. Still to be set in Vercel.
ONBOARDING_FROM_EMAIL=Bizosto <hello@bizosto.com>
# Optional per-role email overrides; passwords remain in E2E_DEMO_PASSWORDS_JSON.
E2E_ADMIN_EMAIL=
E2E_SALES_EMAIL=
E2E_SALES_MANAGER_EMAIL=
E2E_AM_EMAIL=
E2E_AM_MANAGER_EMAIL=
E2E_PRODUCTION_EMAIL=
E2E_PRODUCTION_MANAGER_EMAIL=
E2E_FINANCE_EMAIL=
E2E_HR_EMAIL=
E2E_CLIENT_EMAIL=
# Local/CI verification controls. BASE_URL is set by smoke.yml from E2E_BASE_URL.
BASE_URL=
# GitHub Actions secret consumed by smoke.yml and mapped to BASE_URL.
E2E_BASE_URL=
QA_BASE_URL=
LIGHTHOUSE_PERFORMANCE_SCORE=
NEXT_PUBLIC_LIGHTHOUSE_PERFORMANCE_SCORE=
ANALYZE=false
# Platform-managed names referenced by code but never set in .env files:
# NODE_ENV, NEXT_RUNTIME, CI, VERCEL_URL, VERCEL_GIT_COMMIT_SHA.
# GitHub-only deployment configuration (configure in the protected environment, not here):
# GCP_WORKLOAD_IDENTITY_PROVIDER, GCP_FIREBASE_DEPLOY_SERVICE_ACCOUNT, FIREBASE_PROJECT_ID,
# SONAR_TOKEN, SONAR_HOST_URL.

# ─────────────────────────────────────────────────────────────
# OPTIONAL / DEFERRED — intentionally empty pre-launch. Do NOT hard-require.
# ─────────────────────────────────────────────────────────────
# Stripe + Stripe Connect
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_INVOICE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
# Monitoring and Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
MONITORING_EMAIL_WEBHOOK_URL=
MONITORING_IMMEDIATE_ALERT_WEBHOOK_URL=
MONITORING_PAGERDUTY_WEBHOOK_URL=
MONITORING_SLACK_WEBHOOK_URL=
