# Bizosto ERP — environment variable reference (.env.example)
#
# Copy to .env.local for local work. NEVER commit real secrets.
# The BOOT-CRITICAL block below is validated at server startup by lib/env.ts
# (assertServerEnv, called from instrumentation.ts). Missing/invalid values there
# fail fast with a clear message instead of a confusing runtime 500.
#
# Everything under OPTIONAL / DEFERRED is intentionally NOT required — those
# integrations are empty pre-launch and must not block boot.

# ─────────────────────────────────────────────────────────────
# BOOT-CRITICAL (validated by lib/env.ts — server MUST have these at runtime)
# ─────────────────────────────────────────────────────────────
# Firebase Admin service-account JSON (single line). Must be valid JSON with a
# non-empty "project_id".
FIREBASE_ADMIN_KEY='{"type":"service_account","project_id":"la-creativo-erp","private_key_id":"...","private_key":"...","client_email":"..."}'
# Resend transactional email API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Shared secret authenticating cron routes (Bearer). Must NOT be the literal
# placeholder "change-me-in-production".
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# CLIENT (NEXT_PUBLIC_*) — inlined at build time, checked by the build, not lib/env.ts
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=la-creativo-erp
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=
NEXT_PUBLIC_DEFAULT_TENANT_ID=bizosto
# Canonical app origin. Still to be set in Vercel; several links/redirects fall
# back to https://app.bizosto.com when absent.
NEXT_PUBLIC_APP_URL=https://app.bizosto.com

# ─────────────────────────────────────────────────────────────
# PLATFORM / INFRA (set in production; not boot-gated by lib/env.ts)
# ─────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
INTERNAL_REQUEST_SIGNING_SECRET=
INTERNAL_USAGE_LOG_KEY=
ANTHROPIC_API_KEY=
ERP_INGEST_KEY=
ERP_ENABLE_DEBUG=false
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Onboarding "from" address. Still to be set in Vercel.
ONBOARDING_FROM_EMAIL=Bizosto <hello@bizosto.com>
# Sentry (error tracking).
NEXT_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────
# OPTIONAL / DEFERRED — intentionally empty pre-launch. Do NOT hard-require.
# ─────────────────────────────────────────────────────────────
# Stripe + Stripe Connect
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_INVOICE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
# Other deferred integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DOCUSIGN_INTEGRATION_KEY=
CALENDLY_API_KEY=
XERO_CLIENT_ID=
QUICKBOOKS_CLIENT_ID=
MAILCHIMP_API_KEY=
SLACK_BOT_TOKEN=
SENDGRID_API_KEY=
