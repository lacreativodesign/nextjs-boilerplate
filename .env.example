# Bizosto ERP — environment variable reference (.env.example)
#
# Copy to .env.local for local work. NEVER commit real secrets.
# The BOOT-CRITICAL block below is validated at server startup by lib/env.ts
# (assertServerEnv, called from instrumentation.ts). Missing/invalid values there
# fail fast with a clear message instead of a confusing runtime 500.
#
# Everything under OPTIONAL / DEFERRED is intentionally NOT required — those
# integrations are empty pre-launch and must not block boot.

# ─────────────────────────────────────────────────────────────
# BOOT-CRITICAL (validated by lib/env.ts — server MUST have these at runtime)
# ─────────────────────────────────────────────────────────────
# Firebase Admin service-account JSON (single line). Must be valid JSON with a
# non-empty "project_id".
FIREBASE_ADMIN_KEY='{"type":"service_account","project_id":"la-creativo-erp","private_key_id":"...","private_key":"...","client_email":"..."}'
# Resend transactional email API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Shared secret authenticating cron routes (Bearer). Must NOT be the literal
# placeholder "change-me-in-production".
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# CLIENT (NEXT_PUBLIC_*) — inlined at build time, checked by the build, not lib/env.ts
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=la-creativo-erp
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=
NEXT_PUBLIC_DEFAULT_TENANT_ID=bizosto
# Canonical app origin. Still to be set in Vercel; several links/redirects fall
# back to https://app.bizosto.com when absent.
NEXT_PUBLIC_APP_URL=https://app.bizosto.com

# ─────────────────────────────────────────────────────────────
# PLATFORM / INFRA (set in production; not boot-gated by lib/env.ts)
# ─────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
INTERNAL_REQUEST_SIGNING_SECRET=
# Optional. Signs public notification unsubscribe links. Leave unset and the key is derived
# from INTERNAL_REQUEST_SIGNING_SECRET with a labelled HMAC (one-way, so it cannot be walked
# back to the root), which is why no new production secret is required to ship. Set it to an
# independent random value to isolate this key from the root entirely. Rotating either value
# invalidates unsubscribe links already sitting in customers' inboxes.
# NOTIFICATION_UNSUBSCRIBE_SIGNING_SECRET=
INTERNAL_USAGE_LOG_KEY=
ANTHROPIC_API_KEY=
ERP_INGEST_KEY=
ERP_ENABLE_DEBUG=false
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Onboarding "from" address. Still to be set in Vercel.
ONBOARDING_FROM_EMAIL=Bizosto <hello@bizosto.com>
# Sentry (error tracking).
NEXT_PUBLIC_SENTRY_DSN=
# Golden tenant login password (16 characters minimum). The GitHub Actions secret of
# the same name is what the certification gate seeds AND types, so that copy is the one
# that decides the outcome; set it here too for the Super Admin demo page. Never commit
# the value and never expose it through NEXT_PUBLIC_* variables or UI.
E2E_DEMO_PASSWORD=
# Names the Firebase project a demo reseed may write to. `scripts/seedDemoTenant.ts`
# aborts before touching anything if FIREBASE_ADMIN_KEY targets a different project.
DEMO_FIREBASE_PROJECT_ID=la-creativo-erp

# ─────────────────────────────────────────────────────────────
# DEMO AUTH CERTIFICATION (P0-02)
# ─────────────────────────────────────────────────────────────
# `scripts/certify-demo-auth.ts` walks the WHOLE Firebase Auth population of one project
# and reports what can actually log in to the bizosto-demo golden tenant — which the
# seeder cannot do, because it only ever looks up the ten emails it already knows.
#
# It takes its target from the command line, not from here:
#
#   npm run certify:demo-auth -- --mode=audit --project=la-creativo-erp
#   npm run certify:demo-auth -- --mode=remediate --project=bizosto-staging \
#     --credential-env=FIREBASE_ADMIN_KEY_STAGING
#
# The intended project is stated by the operator and verified against the credential's
# project_id; it is never inferred from whichever service account is in the environment.
# Staging may not be certified with FIREBASE_ADMIN_KEY, and production may not be
# certified with FIREBASE_ADMIN_KEY_STAGING — there is no fallback in either direction.
#
# `--mode=audit` is read-only in the literal sense: Admin inventory only, no mutation and
# NO SIGN-IN. A sign-in writes the account's sign-in metadata and counts toward Identity
# Platform's throttle, so it is not a read. Audit reports population and drift and cannot
# certify. `--mode=remediate` rotates, revokes and restores claims, then proves the ten
# sign in and that the credential published in git history is refused.
#
# Sign-in proof needs the project's Firebase WEB API key, and the tool resolves one itself
# from the Firebase Management API using the Admin credential whose project it has already
# verified — so CI carries no copy, and there is no way for one environment's key to stand
# in for the other's. Set this only for a local run against a project whose service account
# cannot read that API.
# FIREBASE_WEB_API_KEY=
#
# In CI the credentials come from GitHub Environments (firebase-production /
# firebase-staging) whose deployment branches are restricted to main, not from repository
# secrets — see docs/security/p0-02-demo-auth-certification.md.

# ─────────────────────────────────────────────────────────────
# FIREBASE ENVIRONMENT ISOLATION (P0-01) — VERCEL PREVIEW ONLY
# ─────────────────────────────────────────────────────────────
# Production and Preview/staging must never share a Firebase project, database or
# Storage bucket. The contract is lib/firebase/environment.mjs; it is enforced at server
# start (lib/env.ts), in the Admin SDK bootstrap (lib/firebaseAdmin.ts) and by
# /api/public/firebase-config, and it is reported for CI by /api/health.
#
# PRODUCTION needs NEITHER of the two variables below: the production identity is the
# canonical pair pinned in the contract (la-creativo-erp and
# la-creativo-erp.firebasestorage.app), and a production runtime that does not resolve to
# it refuses to boot.
#
# A VERCEL PREVIEW deployment needs BOTH, scoped to the Preview environment ONLY, and its
# NEXT_PUBLIC_FIREBASE_* values must be the staging project's. A Preview that serves the
# production project or bucket, or whose Admin service account belongs to production,
# fails closed.
#
# Both are public identifiers, not secrets — the same strings every browser receives.
# Leave them unset for local work: the contract enforces nothing off Vercel.
#
# The staging project now exists. These are its real, verified identifiers, read from
# the Preview deployment itself (GET <preview>/api/public/firebase-config), not typed
# from memory. They are listed commented out because they belong in Vercel's Preview
# scope, not in a local .env. See docs/runbooks/firebase-environment-isolation.md.
# STAGING_FIREBASE_PROJECT_ID=bizosto-staging
# STAGING_FIREBASE_STORAGE_BUCKET=bizosto-staging.firebasestorage.app

# ─────────────────────────────────────────────────────────────
# OPTIONAL / DEFERRED — intentionally empty pre-launch. Do NOT hard-require.
# ─────────────────────────────────────────────────────────────
# Stripe + Stripe Connect
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_INVOICE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
# Other deferred integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DOCUSIGN_INTEGRATION_KEY=
CALENDLY_API_KEY=
XERO_CLIENT_ID=
QUICKBOOKS_CLIENT_ID=
MAILCHIMP_API_KEY=
SLACK_BOT_TOKEN=
SENDGRID_API_KEY=
