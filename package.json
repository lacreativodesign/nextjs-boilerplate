{
  "name": "la-creativo-erp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "qa": "node scripts/qa-smoke.mjs",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "analyze": "ANALYZE=true next build",
    "typecheck": "tsc --noEmit",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "docs:api": "node scripts/generate-openapi.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "precommit": "node scripts/lint-staged.mjs",
    "quality:ci": "npm run docs:api && npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build && npm run bundle:check && npm run licenses:check"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.1.2",
    "@hookform/resolvers": "^3.3.4",
    "@uploadcare/react-uploader": "^1.12.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "classnames": "^2.3.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.11",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.6.0",
    "framer-motion": "^11.2.11",
    "immer": "^10.0.3",
    "lucide-react": "^0.441.0",
    "next": "14.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.9.15",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@react-pdf/renderer": "^4.3.1",
    "react-hook-form": "^7.53.1",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.8.0",
    "rate-limiter-flexible": "^9.1.0",
    "resend": "^3.2.0",
    "stripe": "^15.12.0",
    "tailwind-merge": "^2.3.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.12",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "msw": "^2.7.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
